# ==============================================================================
# POC Loop Engineering - Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------------------
# Slack Integration Settings
# Required for real-time notifications, thread tracking, and Human-In-The-Loop clarification.
# ------------------------------------------------------------------------------
# Slack App-level token with connections:write scope (starts with xapp-...)
SLACK_APP_TOKEN=xapp-1-...

# Slack Bot User OAuth Token with chat:write, channels:history, etc. (starts with xoxb-...)
SLACK_BOT_TOKEN=xoxb-...

# Slack Signing Secret from Basic Information page
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Enable Bolt Socket Mode (true/false)
SLACK_SOCKET_MODE=true

# Slack Channel ID where updates and stage transitions will be posted (e.g. C0123456789)
SLACK_CHANNEL_ID=C0123456789

# ------------------------------------------------------------------------------
# Microsoft Teams Integration Settings (Optional)
# Supports two delivery methods (no M365 tenant admin permissions required):
#
# Option A: Power Automate / Workflows Webhook URL ("When a webhook request is received")
# TEAMS_WEBHOOK_URL=https://prod-xx.westus.logic.azure.com:443/workflows/...
#
# Option B: Teams Channel Email (Best for enterprise tenants with webhook policies)
# Generate email: In Teams, click "..." on channel -> "Get email address"
# Set channel setting: "Anyone can send emails to this address"
TEAMS_CHANNEL_EMAIL=Agent Dev - TESTING <33ae4fb8.teqfocus.com@in.teams.ms>

# SMTP credentials for sending channel emails (e.g. Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
# SMTP_FROM="Loop Engineering" <your_email@gmail.com>

# Or fallback via Resend API:
# RESEND_API_KEY=re_...
# RESEND_FROM=onboarding@resend.dev

# ------------------------------------------------------------------------------
# Atlassian JIRA Integration Settings
# Required for fetching ticket details, acceptance criteria, comments, and stage transitions.
# ------------------------------------------------------------------------------
# Base URL for JIRA instance or project board URL (e.g. https://yourdomain.atlassian.net)
JIRA_BASE_URL=https://yourdomain.atlassian.net

# Atlassian account user email address
JIRA_USER_EMAIL=developer@yourdomain.com

# Atlassian API Token generated from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# ------------------------------------------------------------------------------
# PR Review Agent Configuration
# ------------------------------------------------------------------------------
# Switch to enable or disable the PR Review Agent (true/false)
# - When true: PR review executes both locally in the orchestrator and via GitHub Actions.
# - When false: PR review execution is bypassed cleanly.
ENABLE_PR_REVIEW_AGENT=true

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# Required for the AI PR Code Review Agent.
# Get an API key from https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

